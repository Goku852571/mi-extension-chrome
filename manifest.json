{
  "manifest_version": 3,
  "name": "YouTube Studio Automator",
  "version": "15.0",
  "description": "Automatiza la subida de videos a YouTube Studio con Side Panel y Persistencia",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "notifications",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://studio.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Automator",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
